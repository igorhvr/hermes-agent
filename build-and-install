#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

echo "==> Removing existing venv (if any)..."
rm -rf ./venv

echo "==> Creating venv with uv (Python 3.14; SQLite >=3.51.3 required)..."
# The runtime is Python 3.14 (`.python-version`, and [tool.uv] environments says
# "3.11 is an install bridge for pre-PM updaters, never a runtime"). The core
# dependencies in pyproject.toml carry a `python_version >= '3.14'` marker, so
# creating this venv on an older interpreter installs no runtime deps at all
# and `hermes` fails at import (e.g. ModuleNotFoundError: ruamel).
#
# SQLite 3.7.0–3.51.2 (excluding the 3.50.7 / 3.44.6 backports) carries the
# WAL-reset corruption bug (https://sqlite.org/wal.html#walresetbug). The guard
# below still fails the build loudly if the interpreter uv resolves links a
# vulnerable SQLite, so a future regression is never silent.
uv venv ./venv --python '>=3.14,<3.15'

# Belt-and-suspenders: fail loudly instead of shipping a vulnerable runtime.
# If a future patch regressed, or uv resolved something unexpected, stop here
# rather than handing back a build that can corrupt state.db on WAL checkpoint.
if ! ./venv/bin/python -c 'import sqlite3, sys; sys.exit(0 if sqlite3.sqlite_version_info >= (3, 51, 3) else 1)'; then
  v=$(./venv/bin/python -c 'import sqlite3; print(sqlite3.sqlite_version)')
  echo "error: venv links SQLite ${v}, vulnerable to the WAL-reset bug" >&2
  echo "       (https://sqlite.org/wal.html#walresetbug) — pin a newer CPython patch." >&2
  exit 1
fi

echo "==> Installing hermes-agent in editable mode (core + [all] + acp)..."
# [all] bundles the extras that cannot be lazy-installed at first use
# (mcp/web/google/acp/...); acp is called out explicitly so the ACP adapter
# keeps working even if the [all] bundle changes. WhatsApp's Python client
# dependency (aiohttp) is installed explicitly in its own step below.
uv pip install -e ".[all,acp]" --python ./venv/bin/python

echo "==> Installing dev toolchain (pytest, ruff, etc.)..."
# `dev` is a PEP 735 dependency group, not a project extra — `.[dev]` silently
# resolves to just the core package with a "does not have an extra named dev"
# warning, so the toolchain must be requested with --group.
uv pip install --group dev --python ./venv/bin/python

echo "==> Installing WhatsApp bridge Python client (aiohttp)..."
# The adapter (plugins/platforms/whatsapp/adapter.py) talks to its local
# Node.js bridge over HTTP via aiohttp; the WhatsApp bridge is the only
# consumer that needs it here, so pin it explicitly rather than trusting the
# [all] -> [sms] transitive to keep providing it.
uv pip install "aiohttp==3.14.5" --python ./venv/bin/python

echo "==> Installing WhatsApp bridge Node dependencies..."
BRIDGE_DIR="scripts/whatsapp-bridge"
if [ -f "$BRIDGE_DIR/package.json" ]; then
  # Force clean install — git deps (@whiskeysockets/baileys) can fail silently
  rm -rf "$BRIDGE_DIR/node_modules"
  (cd "$BRIDGE_DIR" && npm install --no-fund --no-audit)
  if [ ! -d "$BRIDGE_DIR/node_modules/@whiskeysockets/baileys" ]; then
    echo "error: WhatsApp bridge install incomplete — baileys is missing" >&2
    exit 1
  fi
  echo "   ✓ WhatsApp bridge deps installed"
else
  echo "   ⚠ $BRIDGE_DIR/package.json not found, skipping"
fi

echo "==> Verifying ACP and WhatsApp Python dependencies..."
./venv/bin/python - <<'PY'
from importlib import import_module
from importlib.metadata import version

for module, dist in (("acp", "agent-client-protocol"), ("aiohttp", "aiohttp")):
    import_module(module)
    print(f"   ✓ {dist} {version(dist)}")
PY

echo "==> Done!"
echo ""
echo "Try: hermes whatsapp"
echo "     hermes acp"
